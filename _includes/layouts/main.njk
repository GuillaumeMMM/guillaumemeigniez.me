<!doctype html>
<html lang="{{ lang or 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{% if description %}{{ description | escape }}{% else %}Guillaume Meigniez is a French front-end engineer, blogging about design systems, accessibility, data visualization, and creative side projects.{% endif %}">
    <link rel="preload" href="/assets/fonts/IBMPlexSans-Latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/bundle.css">
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/img/favicon.png">
    {% if stylesheets %}
      {% for href in stylesheets %}
        <link rel="stylesheet" href="{{ href }}">
      {% endfor %}
    {% endif %}
    <title>
      {{ title }} |{% if page.url.startsWith("/blog/") and title != "Blog" %}
        Blog |
      {% endif %}
      Guillaume Meigniez</title>
    <noscript>
      <style>
        .webgl {
          display: none;
        }
        .static {
          display: block;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-to-content-link" href="#main">
      {% if lang === 'fr' %}Aller au contenu{% else %}Skip to content{% endif %}
    </a>
    <header class="header">
      {% if page.url === '/' %}
        <h1 class="title">
          <a href="/">Guillaume MEIGNIEZ</a>
        </h1>
      {% else %}
        <p class="title">
          <a href="/">Guillaume MEIGNIEZ</a>
        </p>
      {% endif %}
      <div class="nav-container">{% include "components/nav.njk" %}</div>
    </header>
    <main id="main">
      <div class="content" id="content">{{ content | safe }}</div>
    </main>
    <footer>
      <div class="nav-footer">{% include "components/footer.njk" %}</div>
    </footer>
  </body>
</html></html>